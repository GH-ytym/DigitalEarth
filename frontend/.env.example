# Browser-side Cesium ion access token for World Imagery and World Terrain.
# Use a dedicated read-only token with access to imagery asset 2 and terrain asset 1.
VITE_CESIUM_ION_TOKEN=

# GeoServer WMS endpoint and exact published layer name (case sensitive).
VITE_PROVINCE_WMS_URL=/geoserver/China/wms
VITE_PROVINCE_WMS_LAYER=China:中国省级行政区
VITE_PROVINCE_WMS_STYLE=China:province_outline_dynamic
# Server-side proxy target for Vite dev and preview; restart Vite after changing it.
DIGITALEARTH_GEOSERVER_TARGET=http://127.0.0.1:8081
